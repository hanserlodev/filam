// Prisma schema — FILAM POS Ferretería
// Fuente de verdad: ferreteria-plan-completo.md sección 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  cajero
  administrador
}

enum UnidadMedida {
  unidad
  kg
  metro
  litro
  caja
}

enum EstadoCaja {
  abierta
  cerrada
}

enum TipoComprobante {
  nota_venta
  boleta
  factura
}

enum MetodoPago {
  efectivo
  tarjeta
  transferencia
  yape
  plin
}

enum FormatoImpresion {
  termica
  a4
  boleta_propia
}

enum TipoMovimientoCaja {
  ingreso
  retiro
}

enum TipoMovimientoInventario {
  compra
  venta
  anulacion_venta
  devolucion_proveedor
  merma
  rotura
  perdida
  ajuste_conteo
}

enum EstadoCompra {
  registrada
  anulada
  devuelta
}

enum TipoDocumentoCompra {
  factura
  boleta
  guia
  referencia
}

model Usuario {
  id        String     @id @default(uuid())
  nombre    String     @db.VarChar(150)
  email     String     @unique @db.VarChar(150)
  rol       RolUsuario @default(cajero)
  activo    Boolean    @default(true)
  creado_en DateTime   @default(now()) @db.Timestamptz(6)

  cajaSesiones CajaSesion[]
  ventas       Venta[]
  compras      Compra[]
  ventasAnuladas Venta[]      @relation("VentaAnuladaPor")
  comprasAnuladas Compra[]    @relation("CompraAnuladaPor")
  movimientosCaja CajaMovimiento[]
  evidenciasSubidas CajaEvidencia[]
  movimientosInventario InventarioMovimiento[]
  cambiosPrecios PrecioHistorico[]

  @@map("usuarios")
}

model Categoria {
  id      String    @id @default(uuid())
  nombre  String    @unique @db.VarChar(100)
  orden   Int       @default(0)
  activa  Boolean   @default(true)
  padre_id String?  @map("padre_id")
  padre   Categoria? @relation("CategoriaPadre", fields: [padre_id], references: [id])
  hijas   Categoria[] @relation("CategoriaPadre")
  creado_en DateTime @default(now()) @db.Timestamptz(6)

  productos Producto[]

  @@index([padre_id])
  @@map("categorias")
}

model Producto {
  id            String          @id @default(uuid())
  categoria_id  String?         @map("categoria_id")
  categoria     Categoria?      @relation(fields: [categoria_id], references: [id])
  nombre        String          @db.VarChar(200)
  codigo_barras String?         @unique @db.VarChar(50)
  sku           String?         @unique @db.VarChar(50)
  precio        Decimal         @db.Decimal(10, 2)
  costo         Decimal?        @db.Decimal(10, 2)
  stock         Decimal         @default(0) @db.Decimal(10, 2)
  stock_minimo  Decimal         @default(5) @db.Decimal(10, 2)
  stock_objetivo Decimal?       @db.Decimal(10, 2)
  unidad_medida UnidadMedida    @default(unidad)
  imagen_url    String?
  activo        Boolean         @default(true)
  atributos     Json            @default("{}")
  creado_en     DateTime        @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime       @updatedAt @db.Timestamptz(6)

  ventaItems     VentaItem[]
  compraItems    CompraItem[]
  movimientos    InventarioMovimiento[]
  preciosHistorico PrecioHistorico[]

  @@index([categoria_id])
  @@index([codigo_barras])
  @@map("productos")
}

model CajaSesion {
  id             String      @id @default(uuid())
  usuario_id     String      @map("usuario_id")
  usuario        Usuario     @relation(fields: [usuario_id], references: [id])
  monto_apertura Decimal     @db.Decimal(10, 2)
  monto_cierre   Decimal?    @db.Decimal(10, 2)
  diferencia     Decimal?    @db.Decimal(10, 2)
  total_efectivo Decimal?    @db.Decimal(10, 2)
  total_digital  Decimal?    @db.Decimal(10, 2)
  total_ingresos Decimal?    @db.Decimal(10, 2)
  total_retiros  Decimal?    @db.Decimal(10, 2)
  monto_esperado Decimal?    @db.Decimal(10, 2)
  monto_operativo Decimal?   @db.Decimal(10, 2)
  motivo_diferencia String?  @db.VarChar(300)
  abierta_en     DateTime    @default(now()) @db.Timestamptz(6)
  cerrada_en     DateTime?   @db.Timestamptz(6)
  estado         EstadoCaja  @default(abierta)

  ventas    Venta[]
  movimientos CajaMovimiento[]
  evidencias CajaEvidencia[]

  @@index([usuario_id])
  @@map("caja_sesiones")
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String?  @db.VarChar(150)
  dni_ruc   String?  @db.VarChar(20)
  telefono  String?  @db.VarChar(20)
  creado_en DateTime @default(now()) @db.Timestamptz(6)

  ventas Venta[]

  @@map("clientes")
}

model Venta {
  id                String           @id @default(uuid())
  caja_sesion_id    String           @map("caja_sesion_id")
  cajaSesion        CajaSesion       @relation(fields: [caja_sesion_id], references: [id])
  cliente_id        String?          @map("cliente_id")
  cliente           Cliente?         @relation(fields: [cliente_id], references: [id])
  vendedor_id       String           @map("vendedor_id")
  vendedor          Usuario          @relation(fields: [vendedor_id], references: [id])
  tipo_comprobante  TipoComprobante  @default(nota_venta)
  metodo_pago       MetodoPago
  subtotal          Decimal          @db.Decimal(10, 2)
  descuento_monto   Decimal          @default(0) @db.Decimal(10, 2)
  motivo_descuento  String?          @db.VarChar(300)
  venta_bajo_costo  Boolean          @default(false)
  total             Decimal          @db.Decimal(10, 2)
  idempotency_key   String?          @unique @db.VarChar(100)
  idempotency_hash  String?          @db.VarChar(64)
  serie             String?          @db.VarChar(10)
  numero_correlativo Int?            @map("numero_correlativo")
  comprobante_ref   String?
  formato_impresion FormatoImpresion @default(termica)
  anulada           Boolean          @default(false)
  anulada_en        DateTime?        @db.Timestamptz(6)
  anulada_por_id    String?          @map("anulada_por_id")
  anulada_por       Usuario?         @relation("VentaAnuladaPor", fields: [anulada_por_id], references: [id])
  motivo_anulacion  String?          @db.VarChar(300)
  creado_en         DateTime         @default(now()) @db.Timestamptz(6)

  items VentaItem[]
  pagos VentaPago[]

  @@index([caja_sesion_id])
  @@index([creado_en])
  @@index([serie, numero_correlativo])
  @@map("ventas")
}

model VentaItem {
  id             String   @id @default(uuid())
  venta_id       String   @map("venta_id")
  venta          Venta    @relation(fields: [venta_id], references: [id])
  producto_id    String   @map("producto_id")
  producto       Producto @relation(fields: [producto_id], references: [id])
  cantidad       Decimal  @db.Decimal(10, 2)
  precio_lista   Decimal  @db.Decimal(10, 2)
  descuento_monto Decimal @default(0) @db.Decimal(10, 2)
  precio_unitario Decimal @db.Decimal(10, 2)
  costo_unitario Decimal? @db.Decimal(10, 2)

  @@index([venta_id])
  @@map("venta_items")
}

model Compra {
  id               String              @id @default(uuid())
  proveedor_nombre String?             @db.VarChar(150)
  documento_tipo   TipoDocumentoCompra?
  documento_numero String?             @db.VarChar(100)
  nota_recepcion   String?             @db.VarChar(300)
  estado           EstadoCompra        @default(registrada)
  anulada_en       DateTime?           @db.Timestamptz(6)
  anulada_por_id   String?             @map("anulada_por_id")
  anulada_por      Usuario?            @relation("CompraAnuladaPor", fields: [anulada_por_id], references: [id])
  motivo_anulacion String?             @db.VarChar(300)
  usuario_id       String              @map("usuario_id")
  usuario          Usuario             @relation(fields: [usuario_id], references: [id])
  total            Decimal             @db.Decimal(10, 2)
  creado_en        DateTime            @default(now()) @db.Timestamptz(6)

  items CompraItem[]

  @@map("compras")
}

model CompraItem {
  id             String   @id @default(uuid())
  compra_id      String   @map("compra_id")
  compra         Compra   @relation(fields: [compra_id], references: [id])
  producto_id    String   @map("producto_id")
  producto       Producto @relation(fields: [producto_id], references: [id])
  cantidad       Decimal  @db.Decimal(10, 2)
  costo_unitario Decimal  @db.Decimal(10, 2)

  @@index([compra_id])
  @@map("compra_items")
}

model Configuracion {
  id                 Int               @id @default(1)
  nombre_negocio     String            @default("Ferretería") @db.VarChar(150)
  ruc                String?           @db.VarChar(20)
  direccion          String?           @db.VarChar(200)
  telefono           String?           @db.VarChar(20)
  email              String?           @db.VarChar(100)
  web                String?           @db.VarChar(150)
  instagram          String?           @db.VarChar(100)
  umbral_diferencia  Decimal           @default(10) @db.Decimal(10, 2)
  formato_impresion  FormatoImpresion  @default(termica)
  metodos_pago       MetodoPago[]      @default([efectivo])
  extras_contratados Json              @default("{}")
  actualizado_en     DateTime          @updatedAt @db.Timestamptz(6)

  @@map("configuracion")
}

model VentaPago {
  id          String    @id @default(uuid())
  venta_id    String    @map("venta_id")
  venta       Venta     @relation(fields: [venta_id], references: [id])
  metodo_pago MetodoPago
  monto       Decimal   @db.Decimal(10, 2)
  referencia  String?   @db.VarChar(100)
  creado_en   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([venta_id])
  @@map("venta_pagos")
}

model CajaMovimiento {
  id            String            @id @default(uuid())
  caja_sesion_id String           @map("caja_sesion_id")
  cajaSesion    CajaSesion        @relation(fields: [caja_sesion_id], references: [id])
  tipo          TipoMovimientoCaja
  monto         Decimal           @db.Decimal(10, 2)
  motivo        String            @db.VarChar(300)
  usuario_id    String            @map("usuario_id")
  usuario       Usuario           @relation(fields: [usuario_id], references: [id])
  creado_en     DateTime          @default(now()) @db.Timestamptz(6)

  @@index([caja_sesion_id])
  @@map("caja_movimientos")
}

model CajaEvidencia {
  id            String    @id @default(uuid())
  caja_sesion_id String   @map("caja_sesion_id")
  cajaSesion    CajaSesion @relation(fields: [caja_sesion_id], references: [id])
  ruta_archivo  String    @db.VarChar(300)
  tipo_archivo  String?   @db.VarChar(50)
  tamano_bytes  Int?
  subida_por_id String    @map("subida_por_id")
  subida_por    Usuario   @relation(fields: [subida_por_id], references: [id])
  reemplaza_id  String?   @map("reemplaza_id")
  creado_en     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([caja_sesion_id])
  @@map("caja_evidencias")
}

model InventarioMovimiento {
  id             String                @id @default(uuid())
  producto_id    String                @map("producto_id")
  producto       Producto              @relation(fields: [producto_id], references: [id])
  tipo           TipoMovimientoInventario
  cantidad       Decimal               @db.Decimal(10, 2)
  stock_anterior Decimal               @db.Decimal(10, 2)
  stock_posterior Decimal              @db.Decimal(10, 2)
  motivo         String                @db.VarChar(300)
  usuario_id     String                @map("usuario_id")
  usuario        Usuario               @relation(fields: [usuario_id], references: [id])
  compra_id      String?               @map("compra_id")
  venta_id       String?               @map("venta_id")
  creado_en      DateTime              @default(now()) @db.Timestamptz(6)

  @@index([producto_id])
  @@index([usuario_id])
  @@map("inventario_movimientos")
}

model PrecioHistorico {
  id              String    @id @default(uuid())
  producto_id     String    @map("producto_id")
  producto        Producto  @relation(fields: [producto_id], references: [id])
  costo_anterior  Decimal?  @db.Decimal(10, 2)
  costo_nuevo     Decimal?  @db.Decimal(10, 2)
  precio_anterior Decimal?  @db.Decimal(10, 2)
  precio_nuevo    Decimal?  @db.Decimal(10, 2)
  origen          String    @db.VarChar(50)
  usuario_id      String    @map("usuario_id")
  usuario         Usuario   @relation(fields: [usuario_id], references: [id])
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([producto_id])
  @@map("precios_historico")
}
