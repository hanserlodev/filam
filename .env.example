# Base de datos (Supabase cloud — pooler transaction-mode, runtime)
DATABASE_URL=postgresql://postgres.<ref>:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexión directa (session-mode, usada por Prisma Migrate)
DIRECT_URL=postgresql://postgres.<ref>:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase (auth)
SUPABASE_URL=https://<ref>.supabase.co
GOTRUE_URL=https://<ref>.supabase.co/auth/v1
SERVICE_ROLE_KEY=eyJ...service_role...
GOTRUE_JWT_SECRET=<JWT Secret del proyecto (Settings > API)>

# API (NestJS)
PORT=4000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000